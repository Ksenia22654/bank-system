<c:choose>
    <c:when test="${empty accounts}">
        <p class="empty">Счетов нет.</p>
    </c:when>
    <c:otherwise>
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Номер счёта</th>
                    <b:hasRole role="ADMIN"><th>Клиент</th></b:hasRole>
                    <th>Вид</th><th class="num">Остаток</th><th>Открыт</th><th>Состояние</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="a" items="${accounts}">
                    <tr>
                        <td class="mono"><a href="${app}/accounts/view?id=${a.id}"><c:out value="${a.accountNo}"/></a></td>
                        <b:hasRole role="ADMIN"><td><c:out value="${a.clientName}"/></td></b:hasRole>
                        <td><c:out value="${a.typeName}"/></td>
                        <td class="num nowrap"><b:money value="${a.balance}" currency="${a.currencyCode}"/></td>
                        <td class="nowrap"><fmt:formatDate value="${a.openedOn}" pattern="dd.MM.yyyy"/></td>
                        <td><span class="badge ${a.active ? 'badge-on' : 'badge-off'}">${a.active ? 'Открыт' : 'Закрыт'}</span></td>
                    </tr>
                </c:forEach>
                </tbody>
            </table>
        </div>
    </c:otherwise>
</c:choose>
